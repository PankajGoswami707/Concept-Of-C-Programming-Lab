//C Program to Perform Arithmetic Operations Using Pointers

#include <stdio.h>

int main() {
    int a, b;
    int *p1, *p2;

    printf("Enter two integers: ");
    scanf("%d %d", &a, &b);

    p1 = &a;
    p2 = &b;

    printf("\nArithmetic Operations Using Pointers:\n");
    printf("Addition       = %d\n", *p1 + *p2);
    printf("Subtraction    = %d\n", *p1 - *p2);
    printf("Multiplication = %d\n", (*p1) * (*p2));

    if (*p2 != 0) {
        printf("Division       = %.2f\n", (float)(*p1) / (*p2));
        printf("Modulus        = %d\n", *p1 % *p2);
    } else {
        printf("Division and modulus by zero are not allowed.\n");
    }

    return 0;
}
